      "fields": [
        {"path":["asynchronousWorkspace"],"label":"脚本异步运行","description":"启动后返回本次工作的执行句柄，可查询输出和停止。任务停止会终止进程，未知结果不会自动重跑。工作目录在脚本结束前保持锁定。","type":"boolean","required":false,"defaultEnabled":true},
        {"path":["interactiveWorkspace"],"label":"持续终端交互","description":"可向本任务已启动的受管终端持续输入命令、发送中断或调整大小，不逐次询问；停止任务后终止进程。","type":"boolean","required":false,"defaultEnabled":true},
        {"path":["directWorkspaceNetwork"],"label":"工作区直接联网","description":"本次任务的工作区脚本可访问网络、下载并运行工作区文件，无逐站点审批；停止、撤权或到期后不能继续。","type":"boolean","required":false,"defaultEnabled":true},
        {"path":["workspaceWebSocket"],"label":"工作区 WebSocket 连接","description":"受控代理模式下可使用双向连接，并记录连接及字节量。","type":"boolean","required":false,"defaultEnabled":true},
        {"path":["maximumScriptSeconds"],"label":"单次脚本最长执行时间（秒）","description":"当前桌面 Run 的脚本预算为 3600 秒；工具默认请求 60 秒，可在参数中请求更长时长。停止任务会终止进程。","type":"integer","required":false,"advanced":true,"minimum":1,"maximum":3600,"defaultValue":60},
        {"path":["continuousExecution"],"label":"长任务自动续接","description":"在本次任务中自动接续内部执行段；完成、依赖阻塞、停滞、预算耗尽或你停止时结束。","type":"boolean","required":false,"defaultEnabled":true},
        {"path":["maximumWorkTurns"],"label":"每项工作的累计回合上限（可选）","description":"留空不设置回合上限；填写后包括恢复前已使用的回合。","type":"integer","required":false,"advanced":true,"minimum":24,"maximum":9007199254740991},
        {"path":["maximumWorkMinutes"],"label":"每项工作的累计时长（分钟，可选）","description":"留空不设置总时长；填写后从首次执行开始计算，包含暂停时间。停止、撤权和单次工具的执行控制始终有效。","type":"integer","required":false,"advanced":true,"minimum":1,"maximum":150119987579},
        {"path":["budgets","urls"],"label":"每个发现会话的 URL 上限","description":"控制单次发现的记录数量。","type":"integer","required":false,"advanced":true,"minimum":1,"maximum":512,"defaultValue":64},
        {"path":["budgets","hypotheses"],"label":"任务假设上限","description":"保留的独立假设数量；仍逐一验证。","type":"integer","required":false,"advanced":true,"minimum":1,"maximum":128,"defaultValue":16},
        {"path":["budgets","variants"],"label":"单个实验的变体上限","description":"同一假设内顺序执行的对照变体。","type":"integer","required":false,"advanced":true,"minimum":1,"maximum":16,"defaultValue":1},
        {"path":["budgets","requestsPerCall"],"label":"单次实验调用的请求上限","description":"每条请求独立记录回执。","type":"integer","required":false,"advanced":true,"minimum":1,"maximum":100,"defaultValue":6},
        {"path":["budgets","totalRequests"],"label":"任务 HTTP 工具累计请求上限","description":"包括发现、会话和验证请求；未知结果也占用额度。不包含浏览器内部子资源。","type":"integer","required":false,"advanced":true,"minimum":1,"maximum":4096,"defaultValue":128},
