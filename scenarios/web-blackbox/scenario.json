        { "path": ["budgets", "hypotheses"], "label": "任务假设上限", "description": "保留的独立假设数量；仍逐一验证。", "type": "integer", "required": false, "advanced": true, "minimum": 1, "maximum": 128, "defaultValue": 16 },
        { "path": ["budgets", "variants"], "label": "单个实验的变体上限", "description": "同一假设内顺序执行的对照变体。", "type": "integer", "required": false, "advanced": true, "minimum": 1, "maximum": 16, "defaultValue": 1 },
        { "path": ["budgets", "requestsPerCall"], "label": "单次实验调用的请求上限", "description": "每条请求仍独立检查授权并记录回执。", "type": "integer", "required": false, "advanced": true, "minimum": 1, "maximum": 100, "defaultValue": 6 },
        { "path": ["budgets", "totalRequests"], "label": "任务 HTTP 工具累计请求上限", "description": "包括发现、会话和验证请求；未知结果也占用额度。不包含浏览器内部子资源。", "type": "integer", "required": false, "advanced": true, "minimum": 1, "maximum": 4096, "defaultValue": 128 },
        { "path": ["autonomousWorkspace"], "label": "允许任务内自主执行", "description": "允许模型在本次授权的 Run 工作目录中连续运行离线脚本、装配已启用源码和删除单个文件，不再逐次审批。不会开放联网、用户目录、凭证或宿主安装；不勾选则仍逐次审批。", "type": "boolean", "required": false },
        { "path": ["researchUrlPrefixes"], "label": "公开资料网页前缀", "description": "每行一个允许读取的 HTTPS 文档前缀。独立于调查目标，不授予内网或身份访问权限；留空则不能抓取资料页。", "type": "string-list", "required": false, "advanced": true, "maximumItems": 64, "maximumLength": 4096 },
        { "path": ["targets"], "label": "精确地址", "description": "每行一个完整 URL，按原文精确匹配。不会自动包含同站点其他地址。", "type": "string-list", "required": false, "maximumItems": 128, "maximumLength": 4096 },
        { "path": ["urlPrefixes"], "label": "允许的地址前缀", "description": "每行一个前缀，按原文开头匹配。站点根范围须包含末尾 /，例如 https://example.org/；不要使用裸域名或通配符。留空不授予前缀范围。", "type": "string-list", "required": false, "advanced": true, "maximumItems": 128, "maximumLength": 4096 },
        { "path": ["identityHandles"], "label": "允许使用的身份句柄", "description": "每行一个宿主已保存的身份句柄，不要输入密码或令牌。留空不授予身份使用权限。", "type": "string-list", "required": false, "advanced": true, "maximumItems": 128, "maximumLength": 4096 }
      ]
