{
  "name": "@traceforge/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-driven AI security-agent workbench",
  "author": "TraceForge contributors",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && electron dist/main.js",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win nsis --publish never",
    "dist:mac": "pnpm build && electron-builder --mac dmg zip --publish never",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "@traceforge/server": "workspace:*",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "fastify": "^5.0.0"
  },
  "build": {
    "appId": "com.traceforge.workbench",
    "productName": "TraceForge",
    "asar": true,
    "asarUnpack": ["**/*.node"],
    "directories": { "output": "release" },
    "files": ["dist/**", "package.json"],
    "extraResources": [
      { "from": "../web/dist", "to": "web" }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "TraceForge-${version}-${arch}.${ext}",
      "extraResources": [
        { "from": "../../packages/execution-node/native", "to": "native", "filter": ["**/*"] }
      ]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools", "hardenedRuntime": true, "gatekeeperAssess": false, "notarize": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "extraResources": [
        { "from": "../../packages/execution-node/native", "to": "native", "filter": ["linux-x64/**/*"] }
      ]
    },
    "publish": { "provider": "github", "owner": "m0b1u3", "repo": "TraceForge", "releaseType": "release" }
  }
}
