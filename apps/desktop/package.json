{
  "name": "@traceforge/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-driven AI security-agent workbench",
  "author": "TraceForge contributors",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev:models": "pnpm --filter @traceforge/server build:model-settings && pnpm --filter @traceforge/web build:desktop-preview && pnpm build && electron dist/model-settings-main.js",
    "build": "tsc -p tsconfig.json",
    "prepare:runtime": "node ../../scripts/prepare-desktop-runtime.mjs",
    "restore:node-runtime": "node ../../scripts/restore-node-runtime.mjs",
    "verify:launch": "electron ../../scripts/verify-desktop-launch.mjs",
    "dev": "pnpm --filter @traceforge/server build && pnpm --filter @traceforge/web build:desktop-preview && pnpm build && pnpm prepare:runtime && electron dist/development-main.js",
    "pack": "node ../../scripts/desktop-release-unavailable.mjs",
    "dist": "node ../../scripts/desktop-release-unavailable.mjs",
    "dist:win": "node ../../scripts/desktop-release-unavailable.mjs",
    "dist:mac": "node ../../scripts/desktop-release-unavailable.mjs",
    "dist:linux": "node ../../scripts/desktop-release-unavailable.mjs"
  },
  "dependencies": {
    "@traceforge/shared": "workspace:*",
    "@traceforge/server": "workspace:*"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "fastify": "^5.0.0"
  },
  "build": {
    "appId": "com.traceforge.workbench",
    "productName": "TraceForge",
    "asar": true,
    "asarUnpack": ["**/*.node"],
    "directories": { "output": "release" },
    "files": ["dist/**", "package.json"],
    "extraResources": [
      { "from": "../web/dist", "to": "web" }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "TraceForge-${version}-${arch}.${ext}",
      "extraResources": [
        { "from": "../../packages/execution-node/native", "to": "native", "filter": ["**/*"] }
      ]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools", "hardenedRuntime": true, "gatekeeperAssess": false, "notarize": true },
    "linux": {
      "target": ["deb"],
      "category": "Development",
      "executableName": "traceforge-desktop",
      "desktop": { "entry": { "Exec": "/usr/bin/traceforge %U" } },
      "extraResources": [
        { "from": "../../packages/execution-node/native", "to": "native", "filter": ["linux-x64/**/*"] },
        {
          "from": "../../packages/linux-sandbox-helper/packaging",
          "to": "linux-deployment",
          "filter": ["traceforge-sandboxed", "apparmor/usr.lib.traceforge.traceforge-linux-sandbox"]
        }
      ]
    },
    "deb": {
      "depends": ["apparmor", "libsecret-1-0", "systemd", "xdg-utils"],
      "afterInstall": "../../packages/linux-sandbox-helper/packaging/deb-after-install.sh",
      "afterRemove": "../../packages/linux-sandbox-helper/packaging/deb-after-remove.sh"
    },
    "publish": { "provider": "github", "owner": "m0b1u3", "repo": "TraceForge", "releaseType": "release" }
  }
}
