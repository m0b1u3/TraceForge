{
  "name": "traceforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "verify:release": "pnpm test:fast && pnpm -r build",
    "verify:live": "pnpm test:live",
    "test": "pnpm --filter @traceforge/mcp-poc-server build && vitest run",
    "test:fast": "pnpm --filter @traceforge/mcp-poc-server build && vitest run --exclude apps/server/src/extract-api-endpoints-llm.test.ts --exclude apps/server/src/llm-config-service.test.ts --exclude apps/server/src/routes-mcp.test.ts",
    "test:live": "pnpm --filter @traceforge/mcp-poc-server build && vitest run apps/server/src/extract-api-endpoints-llm.test.ts apps/server/src/llm-config-service.test.ts apps/server/src/routes-mcp.test.ts",
    "test:watch": "vitest",
    "dev:server": "pnpm --filter @traceforge/server dev",
    "dev:web": "pnpm --filter @traceforge/web dev",
    "start:server": "pnpm --filter @traceforge/server start",
    "build:windows-sandbox": "tsx scripts/build-windows-sandbox-helper.mts",
    "release:desktop": "tsx scripts/build-desktop-release.mts",
    "verify:desktop-release": "tsx scripts/verify-desktop-release.mts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
